# Delta Exchange India API Credentials
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Trading Mode
# BACKTEST  - Runs the Web Dashboard backtesting engine
# DEMO      - Live Paper Trading mode using an simulated INR dummy balance (Safe)
# LIVE      - Places REAL orders via the Delta Exchange API (Use with caution!)
MODE=DEMO
